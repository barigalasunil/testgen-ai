{
  "openapi": "3.0.0",
  "info": {
    "title": "SauceDemo API",
    "version": "1.0.0",
    "description": "REST API specification for SauceDemo e-commerce platform used for QA testing"
  },
  "servers": [
    { "url": "https://www.saucedemo.com", "description": "Production" }
  ],
  "paths": {
    "/api/login": {
      "post": {
        "summary": "User login",
        "operationId": "loginUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "example": "standard_user" },
                  "password": { "type": "string", "example": "secret_sauce" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful", "content": { "application/json": { "schema": { "type": "object", "properties": { "token": { "type": "string" }, "userId": { "type": "string" } } } } } },
          "401": { "description": "Invalid credentials" },
          "423": { "description": "User account locked" }
        }
      }
    },
    "/api/inventory": {
      "get": {
        "summary": "Get all products",
        "operationId": "getInventory",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of products",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer" },
                      "name": { "type": "string" },
                      "description": { "type": "string" },
                      "price": { "type": "number" },
                      "image": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/cart": {
      "get": {
        "summary": "Get cart items",
        "operationId": "getCart",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Cart contents" },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "summary": "Add item to cart",
        "operationId": "addToCart",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["itemId", "quantity"],
                "properties": {
                  "itemId": { "type": "integer", "example": 1 },
                  "quantity": { "type": "integer", "example": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Item added" },
          "400": { "description": "Invalid item" },
          "401": { "description": "Unauthorized" }
        }
      },
      "delete": {
        "summary": "Remove item from cart",
        "operationId": "removeFromCart",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Item removed" },
          "404": { "description": "Item not found in cart" }
        }
      }
    },
    "/api/checkout": {
      "post": {
        "summary": "Complete checkout",
        "operationId": "checkout",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["firstName", "lastName", "postalCode"],
                "properties": {
                  "firstName": { "type": "string", "example": "John" },
                  "lastName": { "type": "string", "example": "Doe" },
                  "postalCode": { "type": "string", "example": "90210" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Order placed successfully" },
          "400": { "description": "Missing required fields" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/users/{userId}": {
      "get": {
        "summary": "Get user profile",
        "operationId": "getUser",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "User profile" },
          "404": { "description": "User not found" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    }
  }
}